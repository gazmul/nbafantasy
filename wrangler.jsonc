{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nbafantasy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DUELS",
        "class_name": "DuelRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "LeagueLobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DuelRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "LeagueLobby"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
